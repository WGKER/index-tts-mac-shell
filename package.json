{
  "name": "index-tts-launcher",
  "version": "1.0.0",
  "description": "IndexTTS Mac Launcher",
  "author": "WGKER",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --arm64"
  },
  "build": {
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "extraResources": [
      {
        "from": "./uv",
        "to": "./uv"
      },
      {
        "from": "./index-tts",
        "to": "./index-tts"
      }
    ],
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
